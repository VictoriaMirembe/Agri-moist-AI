# Copy this file to .env and fill in real values. Never commit .env.

# Open-weights model, used to draft advice and translate it (Groq, OpenAI-compatible API).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# If GROQ_API_KEY is blank, the assistant falls back to a deterministic rule-based
# drafting mode so the whole flow still runs end to end without a key.

# SQLite file, created and seeded on first start.
DATABASE_URL=sqlite:///./data/agrimoist.db

# Open-Meteo needs no key.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Demo failure switch for EVALS task 4 / T23: set to 1 to make get_weather fail.
WEATHER_FAIL=0

# Optional: force a specific rain scenario for a demo or an eval run, instead of
# whatever the real weather happens to be today. Leave both commented out for live
# weather. To force a scenario, remove the # and set a number in millimetres.
# WEATHER_OVERRIDE_PAST_MM=
# WEATHER_OVERRIDE_NEXT_MM=

APP_PORT=8000
APP_ENV=development

# Target language for translating approved advice for farmers.
FARMER_LANGUAGE=Ngakarimojong
