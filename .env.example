# Copy this file to .env and fill in real values. Never commit .env.

# Open-weights model, used to draft advice and translate it (Groq, OpenAI-compatible API).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# If GROQ_API_KEY is blank, the assistant falls back to a deterministic rule-based
# drafting mode so the whole flow still runs end to end without a key.

# The database. For a real deployment use Neon Postgres, so data survives restarts:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/agrimoist?sslmode=require
# Blank or this SQLite file = a local database (fine on a laptop). The app creates its
# tables on first start; there are no made-up farmers - officers register real ones.
DATABASE_URL=sqlite:///./data/agrimoist.db

# Soil moisture: "open-meteo" (modelled, at each village) or "sensor-only".
SOIL_SOURCE=open-meteo

# Open-Meteo needs no key.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Demo failure switch for EVALS task 4 / T23: set to 1 to make get_weather fail.
WEATHER_FAIL=0

# Soil moisture comes from a SIMULATED sensor (no hardware). Set to 1 to make
# get_soil_moisture fail, to see the retry-then-gap behaviour.
SOIL_SENSOR_FAIL=0

# Rain guard: with this much rain (mm) or more forecast for the next 7 days, a draft
# that tells farmers to add water is blocked before it reaches the officer's queue.
HEAVY_RAIN_THRESHOLD_MM=15

# SIMULATED irrigation (there is no real valve hardware). The agent may only PROPOSE
# irrigating a plot whose current soil reading is below the dry threshold (%), when the
# weather is known and forecast rain is below HEAVY_RAIN_THRESHOLD_MM. A valve opens
# only after a named officer approves, for at most IRRIGATION_MAX_MINUTES, and closes
# itself when its time is up (checked every IRRIGATION_SWEEP_SECONDS and on start-up).
IRRIGATION_DRY_THRESHOLD_PCT=15
IRRIGATION_DEFAULT_MINUTES=20
IRRIGATION_MAX_MINUTES=30
IRRIGATION_SWEEP_SECONDS=5
# Demo/test fault for the simulated gateway: open_fails or no_confirmation. Either way
# the valve is left closed. Leave blank normally.
IRRIGATION_GATEWAY_FAULT=

# Optional: force a specific rain scenario for a demo or an eval run, instead of
# whatever the real weather happens to be today. Leave both commented out for live
# weather. To force a scenario, remove the # and set a number in millimetres.
# WEATHER_OVERRIDE_PAST_MM=
# WEATHER_OVERRIDE_NEXT_MM=

APP_PORT=8000
APP_ENV=development

# Target language for translating approved advice for farmers, and its ISO 639-3 code.
FARMER_LANGUAGE=Ngakarimojong
FARMER_LANGUAGE_CODE=kdj

# Sunbird AI translates approved advice into Karamojong (its sunflower-9b model is
# trained on Ugandan languages). Get a key at https://api.sunbird.ai
# If blank, the Groq model tries instead; if that fails the farmer sees English.
SUNBIRD_API_KEY=
SUNBIRD_API_URL=https://api.sunbird.ai

# USSD short code from your Africa's Talking USSD channel (sandbox: *384*NNNN#).
# Set the channel's callback URL to https://<your-host>/ussd/africastalking?token=<token>
# and the events callback URL to https://<your-host>/ussd/africastalking/events?token=<token>
USSD_SERVICE_CODE=*384*5951#
# Any long random string. Africa's Talking does not sign callbacks, so this token in
# the callback URL is what stops strangers posting fake farmer reports.
USSD_CALLBACK_TOKEN=

# Signs officer sign-in cookies. Any long random string, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Blank = a new random key on every start (officers sign in again after a restart).
SESSION_SECRET=

# Officers sign in with their own phone number and password (first one on
# /officer/setup); farmers with their phone number and the PIN their officer set.
# Wrong tries before that account is locked, and for how long:
WEB_LOGIN_MAX_ATTEMPTS=5
WEB_LOGIN_LOCK_MINUTES=15
# Officer USSD menu: approve or reject drafts from a basic phone (its own code).
USSD_OFFICER_SERVICE_CODE=*384*5952#
# Wrong PINs in a row before an officer's USSD sign-in is locked, and for how long.
USSD_PIN_MAX_ATTEMPTS=3
USSD_PIN_LOCK_MINUTES=15

# A draft waiting longer than this many hours becomes "expired" and cannot be
# approved on the web or by USSD.
DRAFT_EXPIRY_HOURS=72
